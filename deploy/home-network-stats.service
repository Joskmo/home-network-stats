[Unit]
Description=Private home network traffic Telegram bot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=/srv/self-hosted-music/traffic-telegram-bot
EnvironmentFile=%h/.config/home-network-stats/runtime.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/srv/self-hosted-music/traffic-telegram-bot/.venv/bin/python main.py run
Restart=on-failure
RestartSec=15
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true

[Install]
WantedBy=default.target
